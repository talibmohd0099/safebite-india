# DISABLED -- renamed from .yml to .yml.disabled so GitHub Actions
# stops picking it up at all (it only reads .yml/.yaml). Kept rather
# than deleted because the script and service behind it still exist and
# the reconnaissance notes below are worth keeping.
#
# Why: JioMart was only ever added as a fallback because Blinkit started
# returning 403 on 2026-09-10, and it was never verified against real
# JioMart HTML. Blinkit is serving again (verified via curl -- Node's
# fetch still gets fingerprinted and 403s, see src/services/blinkit.js),
# so the fallback isn't needed and an unverified scraper shouldn't sit
# in the workflow list looking runnable.
#
# To bring it back: rename to scrape-jiomart.yml and do the --list and
# small-run checks the note below describes.

name: Scrape JioMart

# Second, independent product-image/ingredients source alongside
# scrape-blinkit.yml -- Blinkit started returning 403 Forbidden on every
# request as of 2026-09-10 (an active anti-scraping block from sustained
# request volume, not a code problem), so this targets a different
# retailer entirely rather than retrying the same block.
#
# UNVERIFIED against real JioMart HTML -- see the header comment in
# src/services/jiomart.js for why, and treat every run until proven
# otherwise as reconnaissance, not production seeding.
#
# No schedule on purpose, unlike Blinkit's (which only got disabled
# AFTER getting blocked). This starts manual-only and stays that way
# until a --list run and a small real run have both been checked by
# hand -- only then does a conservative schedule get added here.

on:
  workflow_dispatch:
    inputs:
      mode:
        description: 'What to run'
        required: true
        default: 'list'
        type: choice
        options:
          - list
          - sitemap
          - category
          - all
      sitemap_url:
        description: 'Exact sitemap URL from a --list run (only used when mode = sitemap)'
        required: false
        default: ''
      category:
        description: 'Category substring to match (only used when mode = category)'
        required: false
        default: ''
      limit:
        description: 'Products to fetch for sitemap/category mode'
        required: false
        default: '5'
      per_category:
        description: 'Products to fetch per category for --all mode'
        required: false
        default: '5'
      dry_run:
        description: 'Dry run (nothing written to the database)'
        required: false
        default: true
        type: boolean

jobs:
  scrape:
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - run: npm ci

      - name: Scrape
        env:
          VITE_SUPABASE_URL: ${{ secrets.VITE_SUPABASE_URL }}
          VITE_SUPABASE_ANON_KEY: ${{ secrets.VITE_SUPABASE_ANON_KEY }}
          VITE_GEMINI_API_KEY: ${{ secrets.VITE_GEMINI_API_KEY }}
          VITE_GEMINI_API_KEY_2: ${{ secrets.VITE_GEMINI_API_KEY_2 }}
          VITE_GEMINI_API_KEY_3: ${{ secrets.VITE_GEMINI_API_KEY_3 }}
          VITE_CLOUDFLARE_ACCOUNT_ID: ${{ secrets.VITE_CLOUDFLARE_ACCOUNT_ID }}
          VITE_CLOUDFLARE_API_TOKEN: ${{ secrets.VITE_CLOUDFLARE_API_TOKEN }}
        run: |
          DRY_FLAG=""
          if [ "${{ github.event.inputs.dry_run }}" = "true" ]; then DRY_FLAG="--dry-run"; fi

          case "${{ github.event.inputs.mode }}" in
            list)
              node scripts/scrape-jiomart.js --list
              ;;
            sitemap)
              node scripts/scrape-jiomart.js --sitemap "${{ github.event.inputs.sitemap_url }}" --limit "${{ github.event.inputs.limit }}" $DRY_FLAG
              ;;
            category)
              node scripts/scrape-jiomart.js --category "${{ github.event.inputs.category }}" --limit "${{ github.event.inputs.limit }}" $DRY_FLAG
              ;;
            all)
              node scripts/scrape-jiomart.js --all --per-category "${{ github.event.inputs.per_category }}" $DRY_FLAG
              ;;
          esac
